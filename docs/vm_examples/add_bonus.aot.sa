// Native (AOT) counterpart of add_bonus.proc.sa: add `bonus` to
// AMOUNT on every row whose QTY == 5 and return the update count,
// mutating the staged AMOUNT buffer in place. The plugin writes the
// staged buffer back and commits it through the same transaction
// commit as the interpreted procedure, so both engines leave the
// table byte-identical.
//
// Descriptor layout for the module signature
//   @main(&col_qty: ptr, &col_amount: ptr, len: u64, bonus: u64) -> u64
// is, in signature order:
//   slots[0] = col_qty buffer address    slots[1] = col_qty bytes
//   slots[2] = col_amount buffer address slots[3] = col_amount bytes
//   slots[4] = len (row count)           slots[5] = bonus

@export sa_db_aot_abi_version() -> i64:
L_ENTRY:
    v = 1 as i64
    return v

@export sa_db_qmod_main(slots: ptr, slot_count: u64) -> u64:
L_ENTRY:
    qty_addr = load slots+0 as u64
    amt_addr = load slots+16 as u64
    len = load slots+32 as u64
    bonus = load slots+40 as u64
    qty = bitcast qty_addr as ptr
    amt = bitcast amt_addr as ptr
    !qty_addr
    !amt_addr
    idx_slot = stack_alloc 8
    count_slot = stack_alloc 8
    store idx_slot+0, 0 as u64
    store count_slot+0, 0 as u64
    jmp L_LOOP
L_LOOP:
    idx = load idx_slot+0 as u64
    done = uge idx, len
    br done -> L_END, L_BODY
L_BODY:
    off = mul idx, 8
    qp = ptr_add qty, off
    q = load qp+0 as u64
    hit = eq q, 5
    !qp
    !q
    br hit -> L_MATCH, L_NEXT
L_MATCH:
    ap = ptr_add amt, off
    a = load ap+0 as u64
    new_a = add a, bonus
    store ap+0, new_a as u64
    cnt = load count_slot+0 as u64
    cnt_new = add cnt, 1
    store count_slot+0, cnt_new as u64
    !ap
    !a
    !new_a
    !cnt
    !cnt_new
    jmp L_NEXT
L_NEXT:
    next_idx = add idx, 1
    store idx_slot+0, next_idx as u64
    !next_idx
    !off
    !idx
    !done
    !hit
    jmp L_LOOP
L_END:
    result = load count_slot+0 as u64
    !done
    !idx
    !len
    !bonus
    !qty
    !amt
    !slots
    !slot_count
    return result
